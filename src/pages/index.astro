---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, property, catalogue } from '../data/site';
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || '';
const configured = accessKey.length > 10 && !accessKey.includes('replace_');
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const categories = ['All', 'Actual Property Photos', 'Living Room', 'Bedrooms', 'Kitchen', 'Bathroom', 'Exterior and Elevation', 'Floor Plans'];
const schema = {
  '@context': 'https://schema.org', '@type': 'RealEstateAgent', name: business.name,
  telephone: business.phoneDisplay, email: business.email,
  logo: new URL(`${base}bgmg-logo.optimized.png`, Astro.url).href,
  address: { '@type': 'PostalAddress', streetAddress: 'Sector 12, Saini', addressLocality: 'Greater Noida West', addressRegion: 'Uttar Pradesh', postalCode: '203207', addressCountry: 'IN' },
  url: Astro.url.href
};
---
<BaseLayout title="BGMG Infra | Homes Designed Around Your Requirements" description="Explore 1 BHK, 2 BHK, 3 BHK, penthouse and customized residential options from BGMG Infra Pvt Ltd in Greater Noida West.">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header" id="top">
    <a class="brand" href="#top" aria-label="BGMG Infra home" data-scroll-top><img src={`${base}bgmg-logo.optimized.png`} alt="BGMG Infra Pvt Ltd" /></a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav"><span></span><span></span><span></span><span class="sr-only">Menu</span></button>
    <nav id="site-nav" aria-label="Main navigation">
      <a href="#property">Property</a><a href="#catalogue">Catalogue</a><a href="#plans">Floor plans</a><a href="#about">About</a><a href="#contact">Contact</a>
    </nav>
    <a class="header-call" href={`tel:${business.phone}`}>Call now</a>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <img src={`${base}catalog/8.jpeg`} alt="Illustrative architectural visualisation of a contemporary builder floor elevation" fetchpriority="high" />
      <div class="hero-shade"></div>
      <div class="hero-content shell">
        <p class="eyebrow light">BGMG Infra Pvt Ltd <span></span> Greater Noida West</p>
        <h1 id="hero-title">Discover Your Next Home with BGMG Infra</h1>
        <p class="hero-copy">Explore 1 BHK, 2 BHK, 3 BHK, penthouse and customized residential options shaped around your requirements.</p>
        <div class="hero-actions"><a class="button gold" href="#property">Explore Property</a><a class="button ghost" href="#contact" data-enquiry="Site Visit">Schedule a Site Visit</a></div>
        <dl class="hero-facts">
          <div><dt>Property type</dt><dd>{property.type}</dd></div><div><dt>Configurations</dt><dd>{property.configuration}</dd></div><div><dt>Planning</dt><dd>{property.area}</dd></div>
        </dl>
        <p class="concept-note">Hero image: illustrative architectural concept supplied by BGMG Infra.</p>
      </div>
    </section>

    <section class="intro shell" id="property">
      <div><p class="eyebrow">A considered place to live</p><h2>Space for the way your family lives</h2></div>
      <div><p>Whether you need a compact 1 BHK, a practical 2 BHK, a spacious 3 BHK, a premium penthouse or another residential configuration, BGMG Infra helps you explore options suited to your family, lifestyle and space requirements.</p><a class="text-link" href="#contact" data-enquiry="Property Enquiry">Share your requirements <span>→</span></a></div>
    </section>

    <section class="feature-grid shell" aria-label="Property highlights">
      <article><span>01</span><h3>1 BHK</h3><p>Efficient homes planned for compact, comfortable living.</p></article>
      <article><span>02</span><h3>2 &amp; 3 BHK</h3><p>Flexible family homes with practical room configurations.</p></article>
      <article><span>03</span><h3>Penthouses</h3><p>Premium, spacious options for elevated living.</p></article>
      <article><span>04</span><h3>Custom requirements</h3><p>Tell us the home type, area and features you need.</p></article>
    </section>

    <section class="gallery-section" id="catalogue">
      <div class="shell section-head"><div><p class="eyebrow">Property & design catalogue</p><h2>Explore every perspective</h2></div><p>Actual photographs and illustrative concepts are labelled separately for clarity.</p></div>
      <div class="filters shell" role="group" aria-label="Filter catalogue">
        {categories.map((category, i) => <button class:list={{ active: i === 0 }} data-filter={category} aria-pressed={i === 0 ? 'true' : 'false'}>{category}</button>)}
      </div>
      <div class="catalogue-grid shell" aria-live="polite">
        {catalogue.map((item, i) => (
          <article class="catalogue-card" data-category={`${item.category}|${item.actual ? 'Actual Property Photos' : ''}`}>
            <button class="image-button" data-lightbox={i} aria-label={`Open ${item.title} in image viewer`}>
              <img src={`${base}${item.image}`} alt={item.alt} loading="lazy" decoding="async" />
              <span class="expand" aria-hidden="true">↗</span>
              <span class:list={['badge', { actual: item.actual }]}>{item.actual ? 'Actual Photograph' : item.label}</span>
            </button>
            <div class="card-body"><p class="category">{item.category}</p><h3>{item.title}</h3><p>{item.description}</p><button class="text-link enquire-item" data-item={item.title}>Enquire About This Design <span>→</span></button></div>
          </article>
        ))}
        <p class="no-results" hidden>No supplied images are currently available in this category. Ask us about your requirements.</p>
      </div>
      <div class="catalogue-pagination shell" aria-label="Catalogue slider controls">
        <button class="catalogue-prev" type="button" aria-label="Previous catalogue slide">←</button>
        <div class="catalogue-pages" aria-live="polite"></div>
        <button class="catalogue-next" type="button" aria-label="Next catalogue slide">→</button>
      </div>
    </section>

    <section class="plans shell" id="plans">
      <div class="plan-copy"><p class="eyebrow">Floor plans</p><h2>Planning options for every kind of home</h2><p>The drawing shown is a sample 2 BHK layout from the supplied material. BGMG Infra also welcomes enquiries for 1 BHK, 3 BHK, penthouses and other configurations based on customer requirements.</p><div class="notice"><strong>Plans tailored to your needs</strong><p>Final dimensions, room arrangement, area, approvals and construction feasibility are confirmed according to the selected property and your requirements.</p></div><a class="button dark" href="#contact" data-enquiry="Property Enquiry" data-item="Custom residential floor plan">Discuss your floor plan</a></div>
      <button class="plan-image image-button" data-lightbox="6" aria-label="Open sample residential floor plan in image viewer"><img src={`${base}catalog/10.jpeg`} alt="Sample typical floor drawing showing four 2 BHK units" loading="lazy" /></button>
    </section>

    <section class="about" id="about"><div class="shell about-inner"><p class="eyebrow light">About BGMG Infra</p><h2>A straightforward approach to finding the right home for you.</h2><p>BGMG Infra Pvt Ltd presents residential property and design options across different configurations, sizes and lifestyle needs. From 1 BHK homes to family-sized layouts, penthouses and custom requirements, the team provides direct support for property enquiries and site visits.</p><a class="text-link light-link" href="#contact">Start a conversation <span>→</span></a></div></section>

    <section class="contact shell" id="contact">
      <div class="contact-copy"><p class="eyebrow">Contact & site visit</p><h2>Let’s talk about what you’re looking for.</h2><p>Reach the BGMG Infra team directly or send an enquiry. The listed address is the office/contact address and is not presented as the property location.</p>
        <address><a href={`tel:${business.phone}`}><span>Phone</span>{business.phoneDisplay}</a><a href={`mailto:${business.email}`}><span>Email</span>{business.email}</a></address>
        <a class="map-card" href={business.mapsUrl} target="_blank" rel="noreferrer" aria-label="Open BGMG Infra office address in Google Maps">
          <span class="map-pin" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 22s7-6.1 7-13A7 7 0 0 0 5 9c0 6.9 7 13 7 13Z"/><circle cx="12" cy="9" r="2.5"/></svg></span>
          <span class="map-details"><small>Office / contact address</small><strong>{business.address}</strong><b>Open in Google Maps <span aria-hidden="true">↗</span></b></span>
        </a>
      </div>
      <div class="form-panel">
        <h3>Send an enquiry</h3>
        {!configured && <div class="config-warning" role="status"><strong>Form setup required</strong><p>Add a valid Web3Forms access key to enable online delivery. Until then, please call, WhatsApp or email us.</p></div>}
        <form id="enquiry-form" action="https://api.web3forms.com/submit" method="POST" data-configured={String(configured)} novalidate>
          <input type="hidden" name="access_key" value={accessKey} /><input type="hidden" name="subject" value="BGMG Infra [Web-Enquiry]" /><input type="hidden" name="from_name" value="BGMG Infra Website" />
          <input type="checkbox" name="botcheck" class="honeypot" tabindex="-1" autocomplete="off" />
          <div class="field-row"><label>Full name <input name="name" autocomplete="name" required /></label><label>Email <input type="email" name="email" autocomplete="email" required /></label></div>
          <div class="field-row"><label>Phone number <input type="tel" name="phone" autocomplete="tel" pattern="[0-9+() -]{8,20}" required /></label><label>Enquiry type <select name="enquiry_type" required><option value="Property Enquiry">Property Enquiry</option><option value="Site Visit">Site Visit</option><option value="Other">Other</option></select></label></div>
          <label>Preferred configuration <select name="preferred_configuration" required><option value="">Select your requirement</option><option value="1 BHK">1 BHK</option><option value="2 BHK">2 BHK</option><option value="3 BHK">3 BHK</option><option value="Penthouse">Penthouse</option><option value="Other / Custom">Other / Custom requirement</option></select></label>
          <label>Message <textarea name="message" rows="5" required placeholder="Tell us how we can help"></textarea></label>
          <label class="consent"><input type="checkbox" name="consent" value="Yes" required /><span>I consent to being contacted about this enquiry.</span></label>
          <p class="privacy">Your enquiry details are processed through Web3Forms solely so BGMG Infra can contact you about your request.</p>
          <button class="button dark submit" type="submit" disabled={!configured}><span>Send enquiry</span><span class="spinner" hidden aria-hidden="true"></span></button>
          <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>
  <footer><div class="shell footer-inner"><p>© {new Date().getFullYear()} BGMG Infra Pvt Ltd.</p><p class="powered-by">Powered by <a href="https://krishnachandra.com" target="_blank" rel="noreferrer">krishnachandra.com</a></p><div><a href={`mailto:${business.email}`}>Email</a><a href={business.mapsUrl} target="_blank" rel="noreferrer">Directions</a></div></div></footer>
  <a class="whatsapp-float" href={business.whatsappUrl} target="_blank" rel="noreferrer" aria-label="Message BGMG Infra on WhatsApp">
    <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16.04 3A12.8 12.8 0 0 0 5.17 22.57L3.46 28.8l6.38-1.67A12.8 12.8 0 1 0 16.04 3Zm0 23.43c-1.92 0-3.8-.52-5.43-1.5l-.39-.23-3.78.99 1.01-3.69-.25-.38a10.62 10.62 0 1 1 8.84 4.81Zm5.83-7.96c-.32-.16-1.89-.93-2.18-1.04-.29-.11-.5-.16-.72.16-.21.32-.82 1.04-1.01 1.25-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.58a9.6 9.6 0 0 1-1.78-2.21c-.19-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.19.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.12 1.09-1.12 2.66s1.15 3.09 1.3 3.3c.16.21 2.25 3.44 5.46 4.82.76.33 1.36.53 1.82.67.77.24 1.46.21 2.01.13.61-.09 1.89-.77 2.16-1.52.27-.74.27-1.38.19-1.52-.08-.13-.29-.21-.61-.37Z"/></svg>
  </a>
  <nav class="mobile-actions" aria-label="Quick contact"><a href={`tel:${business.phone}`}>☎<span>Call</span></a><a href={business.whatsappUrl} target="_blank" rel="noreferrer">◉<span>WhatsApp</span></a><a href="#contact">✉<span>Enquire</span></a></nav>

  <dialog id="lightbox" aria-label="Image viewer"><button class="close-lightbox" aria-label="Close image viewer">×</button><button class="lightbox-prev" aria-label="Previous image">‹</button><figure><img alt="" /><figcaption><strong></strong><span></span></figcaption></figure><button class="lightbox-next" aria-label="Next image">›</button></dialog>

  <script define:vars={{ catalogue, base }}>
    const navToggle = document.querySelector('.nav-toggle'); const nav = document.querySelector('#site-nav');
    document.querySelector('[data-scroll-top]')?.addEventListener('click', event => { event.preventDefault(); const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches; window.scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' }); history.replaceState(null, '', `${location.pathname}${location.search}`); });
    navToggle?.addEventListener('click', () => { const open = navToggle.getAttribute('aria-expanded') === 'true'; navToggle.setAttribute('aria-expanded', String(!open)); nav?.classList.toggle('open', !open); });
    nav?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { nav.classList.remove('open'); navToggle?.setAttribute('aria-expanded', 'false'); }));
    const cards = [...document.querySelectorAll('.catalogue-card')]; const noResults = document.querySelector('.no-results'); const pagination = document.querySelector('.catalogue-pagination'); const pageDots = document.querySelector('.catalogue-pages'); const previousPage = document.querySelector('.catalogue-prev'); const nextPage = document.querySelector('.catalogue-next'); let currentFilter = 'All'; let currentPage = 0;
    function getPageSize() { if (window.matchMedia('(max-width: 600px)').matches) return 1; if (window.matchMedia('(max-width: 850px)').matches) return 2; return 3; }
    function matchingCards() { return cards.filter(card => currentFilter === 'All' || card.dataset.category?.split('|').includes(currentFilter)); }
    function renderCatalogue() { const matches = matchingCards(); const pageSize = getPageSize(); const pageCount = Math.ceil(matches.length / pageSize); if (currentPage >= pageCount) currentPage = Math.max(0, pageCount - 1); cards.forEach(card => card.hidden = true); matches.slice(currentPage * pageSize, (currentPage + 1) * pageSize).forEach(card => card.hidden = false); if (noResults) noResults.hidden = matches.length !== 0; if (pagination) pagination.hidden = pageCount <= 1; if (previousPage) previousPage.disabled = currentPage === 0; if (nextPage) nextPage.disabled = currentPage >= pageCount - 1; if (pageDots) { pageDots.innerHTML = ''; for (let i = 0; i < pageCount; i++) { const dot = document.createElement('button'); dot.type = 'button'; dot.className = i === currentPage ? 'active' : ''; dot.setAttribute('aria-label', `Go to catalogue slide ${i + 1}`); dot.setAttribute('aria-current', i === currentPage ? 'page' : 'false'); dot.addEventListener('click', () => { currentPage = i; renderCatalogue(); }); pageDots.appendChild(dot); } } }
    document.querySelectorAll('[data-filter]').forEach(button => button.addEventListener('click', () => { currentFilter = button.dataset.filter; currentPage = 0; document.querySelectorAll('[data-filter]').forEach(b => { b.classList.toggle('active', b === button); b.setAttribute('aria-pressed', String(b === button)); }); renderCatalogue(); }));
    previousPage?.addEventListener('click', () => { if (currentPage > 0) { currentPage--; renderCatalogue(); } }); nextPage?.addEventListener('click', () => { if ((currentPage + 1) * getPageSize() < matchingCards().length) { currentPage++; renderCatalogue(); } });
    let catalogueWidth = window.innerWidth; window.addEventListener('resize', () => { if (window.innerWidth !== catalogueWidth) { catalogueWidth = window.innerWidth; currentPage = 0; renderCatalogue(); } }); renderCatalogue();
    const dialog = document.querySelector('#lightbox'); const lbImg = dialog?.querySelector('img'); const lbTitle = dialog?.querySelector('strong'); const lbCaption = dialog?.querySelector('figcaption span'); let active = 0;
    function showImage(index) { active = (index + catalogue.length) % catalogue.length; const item = catalogue[active]; if (lbImg) { lbImg.src = `${base}${item.image}`; lbImg.alt = item.alt; } if (lbTitle) lbTitle.textContent = item.title; if (lbCaption) lbCaption.textContent = `${item.actual ? 'Actual Photograph' : item.label} · ${item.description}`; }
    document.querySelectorAll('[data-lightbox]').forEach(button => button.addEventListener('click', () => { showImage(Number(button.dataset.lightbox)); dialog?.showModal(); }));
    dialog?.querySelector('.close-lightbox')?.addEventListener('click', () => dialog.close()); dialog?.querySelector('.lightbox-prev')?.addEventListener('click', () => showImage(active - 1)); dialog?.querySelector('.lightbox-next')?.addEventListener('click', () => showImage(active + 1)); dialog?.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });
    dialog?.addEventListener('keydown', e => { if (e.key === 'ArrowLeft') showImage(active - 1); if (e.key === 'ArrowRight') showImage(active + 1); });
    const form = document.querySelector('#enquiry-form');
    function prepareEnquiry(type) { const select = form?.querySelector('[name="enquiry_type"]'); if (select && type) select.value = type; }
    document.querySelectorAll('[data-enquiry]').forEach(el => el.addEventListener('click', () => prepareEnquiry(el.dataset.enquiry)));
    document.querySelectorAll('.enquire-item').forEach(button => button.addEventListener('click', () => { prepareEnquiry('Property Enquiry'); document.querySelector('#contact')?.scrollIntoView({ behavior: 'smooth' }); }));
    form?.addEventListener('submit', async e => { e.preventDefault(); const status = document.querySelector('#form-status'); const submit = form.querySelector('[type="submit"]'); const spinner = submit?.querySelector('.spinner'); if (form.dataset.configured !== 'true') { status.textContent = 'Online enquiries are not configured yet. Please call, WhatsApp or email us.'; status.className = 'form-status error'; return; } if (!form.checkValidity()) { form.reportValidity(); return; } submit.disabled = true; spinner.hidden = false; status.textContent = 'Sending your enquiry…'; status.className = 'form-status'; try { const response = await fetch(form.action, { method: 'POST', body: new FormData(form) }); const result = await response.json(); if (!response.ok || !result.success) throw new Error(result.message || 'Submission failed'); form.reset(); status.textContent = 'Thank you. Your enquiry has been sent successfully.'; status.className = 'form-status success'; } catch (error) { status.textContent = 'We could not send your enquiry. Your details are still here—please try again or use call, WhatsApp or email.'; status.className = 'form-status error'; } finally { submit.disabled = false; spinner.hidden = true; } });
  </script>
</BaseLayout>
